{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webmcp-automator.local/schemas/ambient-parse-request.schema.json",
  "title": "Ambient semantic-layer parse request",
  "description": "One policy-approved, privacy-sanitized semantic layer and compact prior action-map context sent to the ambient AI parser.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "idempotencyKey",
    "attempt",
    "retryOf",
    "siteScope",
    "layer",
    "observation",
    "mapBase",
    "context",
    "parser",
    "policy",
    "privacy"
  ],
  "properties": {
    "schemaVersion": {
      "const": "ambient-parse-request/1"
    },
    "requestId": {
      "$ref": "#/$defs/identifier"
    },
    "idempotencyKey": {
      "$ref": "#/$defs/digest"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "retryOf": {
      "anyOf": [
        {
          "$ref": "#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "siteScope": {
      "$ref": "#/$defs/siteScope"
    },
    "layer": {
      "$ref": "#/$defs/layer"
    },
    "observation": {
      "anyOf": [
        {
          "$ref": "#/$defs/observation"
        },
        {
          "type": "null"
        }
      ]
    },
    "mapBase": {
      "$ref": "#/$defs/mapBase"
    },
    "context": {
      "$ref": "#/$defs/context"
    },
    "parser": {
      "$ref": "#/$defs/parser"
    },
    "policy": {
      "$ref": "#/$defs/policy"
    },
    "privacy": {
      "$ref": "#/$defs/privacy"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "siteScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scopeId",
        "origin",
        "routePatterns"
      ],
      "properties": {
        "scopeId": {
          "$ref": "#/$defs/identifier"
        },
        "origin": {
          "type": "string",
          "format": "uri"
        },
        "routePatterns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layerId",
        "sequence",
        "completedAt",
        "completionReason",
        "url",
        "semanticXmlVersion",
        "semanticXmlDigest",
        "semanticXml",
        "evidenceIds"
      ],
      "properties": {
        "layerId": {
          "$ref": "#/$defs/identifier"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "completedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "completionReason": {
          "enum": [
            "initial_document",
            "user_effect",
            "navigation",
            "same_document_route"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "semanticXmlVersion": {
          "const": "semantic-ui/2"
        },
        "semanticXmlDigest": {
          "$ref": "#/$defs/digest"
        },
        "semanticXml": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500000
        },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observationId",
        "eventSequence",
        "fromLayerId",
        "kind",
        "targetEvidenceId",
        "argumentTokens",
        "outcome"
      ],
      "properties": {
        "observationId": {
          "$ref": "#/$defs/identifier"
        },
        "eventSequence": {
          "type": "integer",
          "minimum": 1
        },
        "fromLayerId": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "enum": [
            "click",
            "fill",
            "press",
            "submit",
            "navigate",
            "other"
          ]
        },
        "targetEvidenceId": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "argumentTokens": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^\\{\\{arg\\.[a-z][a-z0-9_]{0,29}\\}\\}$"
          }
        },
        "outcome": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "evidenceIds"
          ],
          "properties": {
            "kind": {
              "enum": [
                "semantic_update",
                "navigation",
                "same_document_route",
                "no_visible_change"
              ]
            },
            "evidenceIds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/identifier"
              }
            }
          }
        }
      }
    },
    "mapBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "digest",
        "previousLayerSequence"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "previousLayerSequence": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "revision": {
                "const": 0
              }
            }
          },
          "then": {
            "properties": {
              "digest": {
                "type": "null"
              },
              "previousLayerSequence": {
                "const": 0
              }
            }
          },
          "else": {
            "properties": {
              "digest": {
                "$ref": "#/$defs/digest"
              },
              "previousLayerSequence": {
                "minimum": 1
              }
            }
          }
        }
      ]
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "states",
        "actions"
      ],
      "properties": {
        "states": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/compactState"
          }
        },
        "actions": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "$ref": "#/$defs/compactAction"
          }
        }
      }
    },
    "compactState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stateId",
        "label",
        "routePattern",
        "evidenceHandles"
      ],
      "properties": {
        "stateId": {
          "$ref": "#/$defs/identifier"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "routePattern": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "evidenceHandles": {
          "$ref": "#/$defs/evidenceHandles"
        }
      }
    },
    "compactAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actionId",
        "title",
        "precondition",
        "effect",
        "inputs",
        "output",
        "evidenceHandles",
        "provenance"
      ],
      "properties": {
        "actionId": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "precondition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "effect": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "inputs": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/compactInput"
          }
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "fields"
          ],
          "properties": {
            "mode": {
              "enum": [
                "none",
                "page",
                "collection"
              ]
            },
            "fields": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,29}$"
              }
            }
          }
        },
        "evidenceHandles": {
          "$ref": "#/$defs/evidenceHandles"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "compactInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "required"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,29}$"
        },
        "type": {
          "enum": [
            "string",
            "number",
            "boolean"
          ]
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "evidenceHandles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "provenance": {
      "enum": [
        "inferred",
        "observed",
        "verified"
      ]
    },
    "parser": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parserId",
        "parserVersion",
        "promptVersion",
        "outputSchemaVersion"
      ],
      "properties": {
        "parserId": {
          "$ref": "#/$defs/identifier"
        },
        "parserVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "promptVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "outputSchemaVersion": {
          "const": "action-map-patch/1"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decisionId",
        "status",
        "scope",
        "checkedAt"
      ],
      "properties": {
        "decisionId": {
          "$ref": "#/$defs/identifier"
        },
        "status": {
          "const": "allowed"
        },
        "scope": {
          "const": "ambient_learn"
        },
        "checkedAt": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sanitizerVersion",
        "redactionCount",
        "redactionDigest",
        "categories",
        "rawPersisted"
      ],
      "properties": {
        "sanitizerVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "redactionCount": {
          "type": "integer",
          "minimum": 0
        },
        "redactionDigest": {
          "$ref": "#/$defs/digest"
        },
        "categories": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "rawPersisted": {
          "const": false
        }
      }
    }
  }
}
