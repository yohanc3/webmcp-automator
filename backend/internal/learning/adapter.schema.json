{
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "enum": ["learned-adapter/1"] },
    "usable": { "type": "boolean" },
    "site": {
      "type": "object",
      "properties": {
        "origin": { "type": "string" },
        "routePatterns": { "type": "array", "items": { "type": "string" }, "maxItems": 8 }
      },
      "required": ["origin", "routePatterns"],
      "additionalProperties": false
    },
    "tool": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,29}$" },
        "description": { "type": "string" },
        "safety": { "type": "string", "enum": ["read", "write", "danger"] },
        "parameters": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,29}$" },
              "description": { "type": "string" },
              "type": { "type": "string", "enum": ["string", "number", "boolean"] },
              "required": { "type": "boolean" }
            },
            "required": ["name", "description", "type", "required"],
            "additionalProperties": false
          }
        },
        "steps": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "properties": {
              "op": { "type": "string", "enum": ["fill", "click", "press", "wait", "extract"] },
              "target": { "$ref": "#/$defs/locator" },
              "valueFrom": { "type": ["string", "null"] },
              "literalValue": { "type": ["string", "null"] },
              "key": { "type": ["string", "null"] },
              "expectNavigation": { "type": "boolean" },
              "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 30000 }
            },
            "required": ["op", "target", "valueFrom", "literalValue", "key", "expectNavigation", "timeoutMs"],
            "additionalProperties": false
          }
        },
        "output": {
          "type": "object",
          "properties": {
            "mode": { "type": "string", "enum": ["page", "collection"] },
            "collectionRoot": { "$ref": "#/$defs/locator" },
            "item": { "$ref": "#/$defs/locator" },
            "limit": { "type": "integer", "minimum": 1, "maximum": 25 },
            "fields": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "locator": { "$ref": "#/$defs/locator" },
                  "attribute": { "type": ["string", "null"] },
                  "required": { "type": "boolean" }
                },
                "required": ["name", "locator", "attribute", "required"],
                "additionalProperties": false
              }
            }
          },
          "required": ["mode", "collectionRoot", "item", "limit", "fields"],
          "additionalProperties": false
        },
        "annotations": {
          "type": "object",
          "properties": {
            "readOnlyHint": { "type": "boolean" },
            "untrustedContentHint": { "type": "boolean" }
          },
          "required": ["readOnlyHint", "untrustedContentHint"],
          "additionalProperties": false
        }
      },
      "required": ["name", "description", "safety", "parameters", "steps", "output", "annotations"],
      "additionalProperties": false
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence": { "type": "string" },
    "issues": { "type": "array", "items": { "type": "string" }, "maxItems": 12 }
  },
  "required": ["schemaVersion", "usable", "site", "tool", "confidence", "evidence", "issues"],
  "additionalProperties": false,
  "$defs": {
    "locator": {
      "type": "object",
      "properties": {
        "css": { "type": ["string", "null"] },
        "role": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "placeholder": { "type": ["string", "null"] },
        "text": { "type": ["string", "null"] },
        "hrefContains": { "type": ["string", "null"] }
      },
      "required": ["css", "role", "name", "placeholder", "text", "hrefContains"],
      "additionalProperties": false
    }
  }
}
